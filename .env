# ===========================================
# Crowdflix Frontend Environment Configuration
# ===========================================

# API Configuration
VITE_API_URL=https://api.crowdflix.io
VITE_BACKEND_URL=https://api.crowdflix.io

# Sentry Error Tracking
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# WalletConnect Configuration
VITE_WC_PROJECT_ID=your-walletconnect-project-id

# Flow Blockchain Configuration
VITE_FLOW_NETWORK=testnet
VITE_FLOW_ACCESS_NODE=https://rest-testnet.onflow.org

# App Configuration
VITE_APP_TITLE=Crowdflix
VITE_APP_DESCRIPTION=NFT Marketplace for Movie Moments

# Development Configuration
VITE_USE_MOCKS=false
VITE_DEBUG=false

